{
    "name": "nawasara/api",
    "description": "Public REST API plumbing for the Nawasara superapp framework — API token management with hashed storage, scope registry, HMAC-signed stream URLs, and audit log infrastructure. Domain packages (cctv, wifi, ...) provide their own routes/controllers/transformers; this package owns auth + scope + token lifecycle.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "api",
        "rest",
        "token",
        "scope",
        "public-api"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/api/issues",
        "source": "https://github.com/nawasara/api"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Api\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "nawasara/ui": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Api\\ApiServiceProvider"
            ],
            "aliases": {
                "Api": "Nawasara\\Api\\Facades\\Api"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
